# Short paste-at-start brief for external TUIs (Grok Build). Always exit 0.
cmd_brief() {
    path_arg=$(get_path_arg "$@")
    root="$(project_root "$path_arg")"
    cf="$(current_file "$root")"
    printf '=== aether brief ===\n'
    printf 'root: %s\n' "$root"
    if [ ! -f "$cf" ]; then
        printf 'CURRENT: MISSING — run aether current init\n'
        printf 'preflight: n/a\n'
        printf 'note: external TUI does not auto-preflight\n'
        printf '===================\n'
        return 0
    fi
    next=$(current_field "$root" Next 2>/dev/null || true)
    phase=$(current_field "$root" Phase 2>/dev/null || true)
    status=$(current_field "$root" Status 2>/dev/null || true)
    appr=$(current_field "$root" Approval 2>/dev/null || true)
    printf 'Next: %s\n' "${next:-(unset)}"
    printf 'Phase/Status/Approval: %s / %s / %s\n' \
        "${phase:-(unset)}" "${status:-(unset)}" "${appr:-(unset)}"
    if [ -n "$next" ] && [ "$next" != "unset" ]; then
        # brief must not write events/receipts (GPT-5.6 10_ review)
        set +e
        pf_out="$(AETHER_PREFLIGHT_DRY=1 cmd_preflight "$next" "$root" 2>&1)"
        pf_ec=$?
        set -e
        if [ "$pf_ec" -eq 0 ]; then
            printf 'preflight(%s): would ALLOW\n' "$next"
        else
            printf 'preflight(%s): would REFUSE\n' "$next"
            printf '%s\n' "$pf_out" | head -2 | sed 's/^/  /'
        fi
    else
        printf 'preflight: Next unset\n'
    fi
    ef="$(events_file "$root")"
    if [ -f "$ef" ]; then
        printf 'events (last 3):\n'
        tail -n 3 "$ef" | sed 's/^/  /'
    else
        printf 'events: (none)\n'
    fi
    # light drift summary without failing
    if command -v git >/dev/null 2>&1 && [ -d "$root/.git" ] || git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        dirty=$(git -C "$root" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        if [ "${dirty:-0}" -gt 0 ]; then
            printf 'drift: %s dirty path(s) — run: aether drift\n' "$dirty"
        else
            printf 'drift: clean\n'
        fi
    else
        printf 'drift: n/a (not a git work tree)\n'
    fi
    printf 'note: Grok/external TUI does not auto-preflight; human is the gate\n'
    printf '===================\n'
    return 0
}

# Git-based out-of-band edit report. Exit 0 clean, 1 drift. Never writes CURRENT.
cmd_drift() {
    path_arg=$(get_path_arg "$@")
    root="$(project_root "$path_arg")"
    if ! command -v git >/dev/null 2>&1; then
        printf 'drift: git not available\n' >&2
        return 0
    fi
    if ! git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf 'drift: not a git work tree (%s)\n' "$root"
        return 0
    fi
    # porcelain: path status
    dirty=0
    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        # format: XY PATH or XY ORIG -> PATH
        path=$(printf '%s\n' "$line" | sed 's/^.. //; s/.* -> //')
        [ -n "$path" ] || continue
        printf 'DRIFT: %s edited outside protocol\n' "$path"
        dirty=1
    done <<EOF
$(git -C "$root" status --porcelain 2>/dev/null)
EOF
    if [ "$dirty" = "1" ]; then
        return 1
    fi
    printf 'drift: clean\n'
    return 0
}

# Read-only: would preflight allow this action right now?
# Exit 0 allow, 3 protocol refuse (matches preflight/next refuse).
# Never writes events or preflight receipts (AETHER_PREFLIGHT_DRY=1).
cmd_probe() {
    [ $# -ge 1 ] || die_usage 'usage: aether probe <action-id> [path]'
    action="$1"
    shift
    path_arg=$(get_path_arg "$@")
    root="$(project_root "$path_arg")"
    cf="$(current_file "$root")"
    if [ ! -f "$cf" ]; then
        printf 'probe: REFUSE (no CURRENT.md)\n'
        return 3
    fi
    set +e
    out="$(AETHER_PREFLIGHT_DRY=1 cmd_preflight "$action" "$root" 2>&1)"
    ec=$?
    set -e
    if [ "$ec" -eq 0 ]; then
        printf 'probe: ALLOW %s\n' "$action"
        printf '%s\n' "$out" | head -1 | sed 's/^/  /'
        return 0
    fi
    printf 'probe: REFUSE %s\n' "$action"
    printf '%s\n' "$out" | head -2 | sed 's/^/  /'
    return 3
}

cmd_event() {
    [ $# -gt 0 ] || die_usage 'usage: aether event <message> [path]'
    # If last arg is a directory, treat as path
    root="$(pwd -P)"
    msg="$*"
    # shellcheck disable=SC2124
    last="$(eval "printf '%s' \"\${$#}\"")"
    if [ -d "$last" ]; then
        root="$(project_root "$last")"
        # rebuild msg without last
        msg=""
        i=1
        n=$#
        for a in "$@"; do
            if [ "$i" -lt "$n" ]; then
                if [ -n "$msg" ]; then msg="$msg $a"; else msg="$a"; fi
            fi
            i=$((i + 1))
        done
    fi
    [ -n "$msg" ] || die_usage 'empty event message'
    append_event "$root" note \
        "$(printf '"message":"%s","by":"human"' "$(json_escape "$msg")")"
    printf 'event logged → %s\n' "$(events_file "$root")"
}

cmd_artifact() {
    # aether artifact <file> [--action A] [--status S] [--project DIR]
    [ $# -gt 0 ] || die_usage 'usage: aether artifact <path> [--action A] [--status S] [--project DIR]'
    art=""
    action=""
    status="produced"
    proj=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --action) action="${2:-}"; shift 2 || shift ;;
            --status) status="${2:-}"; shift 2 || shift ;;
            --project) proj="${2:-}"; shift 2 || shift ;;
            -*) die_usage "unknown flag: $1" ;;
            *)
                if [ -z "$art" ]; then art="$1"; else die_usage "unexpected arg: $1"; fi
                shift
                ;;
        esac
    done
    [ -n "$art" ] || die_usage 'artifact path required'    root="$(project_root "$proj")"
    ensure_aether_dirs "$root"
    # resolve art path for display
    case "$art" in
        /*) art_abs="$art" ;;
        *) art_abs="$(cd "$(dirname "$art")" 2>/dev/null && pwd -P)/$(basename "$art")" 2>/dev/null || art_abs="$art" ;;
    esac
    baseline=$(current_field "$root" Baseline 2>/dev/null || true)
    next=$(current_field "$root" Next 2>/dev/null || true)
    [ -n "$action" ] || action="${next:-unknown}"
    csum=""
    if [ -f "$art_abs" ]; then
        csum=$(cksum "$art_abs" 2>/dev/null | awk '{print $1}')
    fi
    ts="$(now_iso)"
    id=$(printf '%s' "$ts" | tr -c 'A-Za-z0-9' '_')
    base_name=$(basename "$art")
    meta="$(artifacts_dir "$root")/${id}_${base_name}.json"
    tmp="$(aether_tmpfile "$root" artmeta)"
    {
        printf '{\n'
        printf '  "ts": "%s",\n' "$(json_escape "$ts")"
        printf '  "path": "%s",\n' "$(json_escape "$art")"
        printf '  "action": "%s",\n' "$(json_escape "$action")"
        printf '  "status": "%s",\n' "$(json_escape "$status")"
        printf '  "baseline": "%s",\n' "$(json_escape "${baseline:-}")"
        printf '  "checksum": "%s"\n' "$(json_escape "${csum:-}")"
        printf '}\n'
    } > "$tmp" || die "artifact meta write failed"
    mv -f "$tmp" "$meta"
    append_event "$root" artifact \
        "$(printf '"path":"%s","action":"%s","status":"%s","checksum":"%s","meta":"%s"' \
            "$(json_escape "$art")" "$(json_escape "$action")" \
            "$(json_escape "$status")" "$(json_escape "${csum:-}")" \
            "$(json_escape "$meta")")"
    printf 'artifact registered → %s\n' "$meta"
}

# --- state ------------------------------------------------------------

write_state() {
    root="$(project_root "$1")"
    sf="$(state_file "$root")"
    ensure_aether_dirs "$root"
    tmp="$(aether_tmpfile "$root" state)"
    {
        printf '{\n  "last_distill": "%s",\n  "file_count": %s,\n  "tree_hash": "%s"\n}\n' "$2" "$3" "$4"
    } > "$tmp" || die "write_state: temp write failed"
    mv -f "$tmp" "$sf"
}

# Secure temp under .aether/ (not predictable /tmp/aether.$$)
aether_tmpfile() {
    root="$(project_root "$1")"
    ensure_aether_dirs "$root"
    ad="$(aether_dir "$root")"
    # mktemp preferred; fallback under .aether with umask
    if tmp="$(mktemp "$ad/.tmp.XXXXXX" 2>/dev/null)"; then
        printf '%s\n' "$tmp"
        return 0
    fi
    tmp="$ad/.tmp.$$.$2.$$"
    ( umask 077; : > "$tmp" ) || die "cannot create temp file in $ad"
    printf '%s\n' "$tmp"
}

read_state_field() {
    sf="$(state_file "$1")"
    [ -f "$sf" ] || return 1
    case "$2" in
        last_distill) grep -o '"last_distill": *"[^"]*"' "$sf" | cut -d'"' -f4 ;;
        file_count)   grep -o '"file_count": *[0-9]*' "$sf" | awk -F: '{print $2}' | tr -d ' ,' ;;
        tree_hash)    grep -o '"tree_hash": *"[^"]*"' "$sf" | cut -d'"' -f4 ;;
    esac
}

# --- human vs generated context ---------------------------------------
# Human prose lives outside markers and survives distill.
# Generated inventory lives strictly between markers.

GEN_START='<!-- aether:generated:start -->'
GEN_END='<!-- aether:generated:end -->'

# Return 0 if markers are absent (legacy) or form exactly one ordered pair.
# Return 1 if corrupt (missing end, duplicate, or end before start).
validate_context_markers() {
    ctx="$1"
    [ -f "$ctx" ] || return 0
    starts=$(grep -c 'aether:generated:start' "$ctx" 2>/dev/null || true)
    ends=$(grep -c 'aether:generated:end' "$ctx" 2>/dev/null || true)
    starts=${starts:-0}
    ends=${ends:-0}
    if [ "$starts" -eq 0 ] && [ "$ends" -eq 0 ]; then
        return 0
    fi
    if [ "$starts" -ne 1 ] || [ "$ends" -ne 1 ]; then
        return 1
    fi
    awk '
        /<!-- aether:generated:start -->/ { s=NR }
        /<!-- aether:generated:end -->/   { e=NR }
        END { exit (s && e && s < e) ? 0 : 1 }
    ' "$ctx"
}

extract_human_context() {
    ctx="$1"
    [ -f "$ctx" ] || return 0
    if grep -q 'aether:generated:start' "$ctx" 2>/dev/null; then
        awk '
            /<!-- aether:generated:start -->/ { skip=1; next }
            /<!-- aether:generated:end -->/   { skip=0; next }
            !skip { print }
        ' "$ctx"
    else
        # Legacy full-file regenerate: keep body minus old <!--aether ... --> machine block
        awk '
            /<!--aether[[:space:]]*/, /-->/ { next }
            { print }
        ' "$ctx"
    fi
}

build_generated_body() {
    root="$1"
    cnt="$2"
    hsh="$3"
    ts="$4"
    printf '%s\n' "$GEN_START"
    printf '## Root\n%s\n\n' "$root"
    printf '## Files (scoped)\n%d\n\n' "$cnt"
    printf '## Sample\n'
    collect_files "$root" | head -25 | sed "s|^$root/||;s|^| - \`|;s|$|\`|"
    printf '\n'
    if [ -f "$root/README.md" ]; then
        printf '## README (head)\n\n```\n'
        head -c 1600 "$root/README.md" | head -35
        printf '\n```\n\n'
    fi
    printf '## State\n- last: %s\n- hash: %s\n\n' "$ts" "$hsh"
    printf '<!--aether\n{"last_distill":"%s","file_count":%s,"tree_hash":"%s"}\n-->\n' "$ts" "$cnt" "$hsh"
    printf '%s\n' "$GEN_END"
}

# --- distill (dumb shell version) -------------------------------------

dumb_distill() {
    root="$(project_root "$1")"
    ctx="$(ctx_file "$root")"
    if ! validate_context_markers "$ctx"; then
        die "corrupt generated markers in $ctx — refuse automatic distill. Fix markers (exactly one start before one end) then retry."
    fi
    cnt="$(file_count "$root")"
    hsh="$(tree_hash "$root")"
    ts="$(now_iso)"
    tmp="$(aether_tmpfile "$root" ctx)"

    {
        human="$(extract_human_context "$ctx" 2>/dev/null || true)"
        if [ -n "$human" ]; then
            printf '%s\n\n' "$human"
        else
            printf '# Context — %s\n\n' "$(basename "$root")"
            printf 'Human notes go **above** the generated markers. They survive aether distill.\n\n'
        fi
        build_generated_body "$root" "$cnt" "$hsh" "$ts"
    } > "$tmp" || die "dumb_distill: temp write failed"

    mv -f "$tmp" "$ctx"
    write_state "$root" "$ts" "$cnt" "$hsh"
}

# --- optional smart python distill ------------------------------------

python_distill() {
    root="$(project_root "$1")"
    py="$AETHER_ROOT/python/aether_distill.py"
    if command -v python3 >/dev/null 2>&1 && [ -f "$py" ]; then
        python3 "$py" "$root" || dumb_distill "$root"
    else
        dumb_distill "$root"
    fi
}

# --- hooks + trust ----------------------------------------------------

trusted_file() { printf '%s/.aether/trusted\n' "$(project_root "$1")"; }

hooks_enabled() {
    root="$(project_root "$1")"
    [ "${AETHER_NO_HOOKS:-0}" = "1" ] && return 1
    [ -f "$(trusted_file "$root")" ]
}

run_hook() {
    name="$1"; shift
    root="$(project_root "$1")"
    h="$(hooks_dir "$root")/$name"

    if [ "${AETHER_NO_HOOKS:-0}" = "1" ]; then
        return 0
    fi
    if [ ! -f "$h" ] && [ ! -x "$h" ]; then
        return 0
    fi
    if ! hooks_enabled "$root"; then
        printf 'aether: hooks skipped (project untrusted). Run: aether trust [%s]\n' "$root" >&2
        printf 'aether: or pass --no-hooks to silence this for this run.\n' >&2
        return 0
    fi

    # Mutually exclusive: executable OR sh - never both (review finding #2)
    if [ -x "$h" ]; then
        (cd "$root" && "$h") || printf 'aether: hook %s failed (exit %s)\n' "$name" "$?" >&2
    elif [ -f "$h" ]; then
        (cd "$root" && sh "$h") || printf 'aether: hook %s failed (exit %s)\n' "$name" "$?" >&2
    fi
}

# --- commands ---------------------------------------------------------

cmd_init() {
    p=$(get_path_arg "$@")
    root="$(project_root "$p")"
    ensure_aether_dirs "$root"

    sf="$(scope_file "$root")"
    [ -f "$sf" ] || printf '.\n' > "$sf"

    hd="$(hooks_dir "$root")"
    # Auto-trust only when every default hook is created by this init.
    # Pre-existing hooks (e.g. after clone) must not become trusted silently.
    pre_existing_hooks=0
    for hook in on-save on-distill; do
        if [ -f "$hd/$hook" ]; then
            pre_existing_hooks=1
            continue
        fi
        {
            printf '#!/bin/sh\n# %s hook\n' "$hook"
            cat <<'HOOKBODY'
# Resolve aether robustly:
#   - $AETHER_BIN env
#   - aether in $PATH
#   - sibling "aether" script two directories up (common when aether lives at project root)
if command -v aether >/dev/null 2>&1; then
  AETHER_BIN="aether"
elif [ -n "$AETHER_BIN" ] && [ -x "$AETHER_BIN" ]; then
  :
else
  AETHER_BIN="$(cd "$(dirname "$0")/../.." && pwd)/aether"
  [ -x "$AETHER_BIN" ] || AETHER_BIN="aether"
fi

echo "[aether] HOOKNAME in $(basename "$(pwd)")"
# "$AETHER_BIN" distill --quiet || true
HOOKBODY
        } | sed "s/HOOKNAME/$hook/g" > "$hd/$hook"
        chmod +x "$hd/$hook" 2>/dev/null || true
    done

    if [ "$pre_existing_hooks" -eq 0 ]; then
        printf 'trusted %s\n' "$(now_iso)" > "$(trusted_file "$root")"
        trust_note='trusted'
    else
        trust_note='untrusted (pre-existing hooks — run: aether trust)'
    fi

    [ -f "$(ctx_file "$root")" ] || dumb_distill "$root"

    printf 'initialized: %s\n' "$root"
    printf '  .context.md + .aether/{state.json,hooks/,.scope} (%s)\n' "$trust_note"
}

cmd_status() {
    p=$(get_path_arg "$@")
    root="$(project_root "$p")"
    printf 'root: %s\n\n' "$root"

    cf="$(current_file "$root")"
    if [ -f "$cf" ]; then
        printf 'CURRENT.md (authority):\n'
        printf '  Objective: %s\n' "$(current_field "$root" Objective 2>/dev/null || echo '(unset)')"
        printf '  Phase:     %s\n' "$(current_field "$root" Phase 2>/dev/null || echo '(unset)')"
        printf '  Status:    %s\n' "$(current_field "$root" Status 2>/dev/null || echo '(unset)')"
        printf '  Next:      %s\n' "$(current_field "$root" Next 2>/dev/null || echo '(unset)')"
        printf '  Approval:  %s\n' "$(current_field "$root" Approval 2>/dev/null || echo '(unset)')"
    else
        printf 'CURRENT.md: MISSING (no authority — aether current init)\n'
    fi
    ef="$(events_file "$root")"
    if [ -f "$ef" ]; then
        printf 'events: %s lines → %s\n' "$(wc -l < "$ef" | tr -d ' ')" "$ef"
    else
        printf 'events: (none yet)\n'
    fi
    printf '\n'

    [ -f "$(ctx_file "$root")" ] && printf '.context.md: %s bytes\n' "$(wc -c < "$(ctx_file "$root")" | tr -d ' ')" || printf '.context.md: MISSING\n'

    stf="$(state_file "$root")"
    if [ -f "$stf" ]; then
        printf '.aether/state.json:\n'
        sed 's/^/  /' "$stf"
    else
        printf '.aether/state.json: (will be created on distill)\n'
    fi

    printf '\nscope (.aether/.scope):\n'
    read_scope "$root" | sed 's/^/  /'

    printf '\nhooks:\n'
    hd="$(hooks_dir "$root")"
    if [ -d "$hd" ]; then
        # Portable list (no ls/SC2012; no GNU -printf)
        listed=$(find "$hd" -mindepth 1 -maxdepth 1 2>/dev/null | sed 's|.*/|  |')
        if [ -n "$listed" ]; then
            printf '%s\n' "$listed"
        else
            echo '  (none)'
        fi
    else
        echo '  (none)'
    fi

    if [ -f "$root/.aether/app.json" ]; then
        printf '\napp: %s\n' "$root/.aether/app.json"
    fi
    printf '\ndaily: aether panel   # Project Panel TUI (buttons)\n'
    if [ -f "$root/.aether/PANEL.md" ]; then
        printf 'panel: %s (+ panel.html)\n' "$root/.aether/PANEL.md"
    fi
}

cmd_distill() {
    p=$(get_path_arg "$@")
    root="$(project_root "$p")"
    quiet=0
    for a in "$@"; do
        case "$a" in
            --quiet) quiet=1 ;;
            --no-hooks) AETHER_NO_HOOKS=1; export AETHER_NO_HOOKS ;;
        esac
    done

    ensure_aether_dirs "$root"
    # dumb_distill/python_distill update .context.md (preserving human section) + state
    python_distill "$root"

    cnt=$(file_count "$root")
    hsh=$(tree_hash "$root")
    run_hook on-distill "$root"

    if [ "$quiet" = 0 ]; then
        printf 'distilled (%s files, hash %s)\n' "$cnt" "$hsh"
    fi
    return 0
}

cmd_watch() {
    # first argument may be the literal subcommand "watch"
    if [ "$1" = "watch" ]; then shift; fi

    poll=""
    path_arg=""

    # parse --poll and an optional path (path can be before or after flags)
    while [ $# -gt 0 ]; do
        case "$1" in
            --poll)
                poll="${2:-5}"
                shift 2 || shift
                ;;
            --no-hooks)
                AETHER_NO_HOOKS=1; export AETHER_NO_HOOKS
                shift
                ;;
            -*)
                shift
                ;;
            *)
                # treat as path
                if [ -z "$path_arg" ]; then
                    path_arg="$1"
                fi
                shift
                ;;
        esac
    done

    root="$(project_root "$path_arg")"

    if [ -n "$poll" ]; then
        printf 'watch (poll %ss, change-driven). Ctrl-C stops.\n' "$poll"
        prev=""
        while true; do
            sleep "$poll"
            cur=$(tree_hash "$root")
            if [ "$cur" != "$prev" ]; then
                prev="$cur"
                cmd_distill "$root" --quiet
                run_hook on-save "$root"
            fi
        done
        return
    fi

    if ! command -v entr > /dev/null 2>&1; then
        cat >&2 <<'E'
entr not found.

Recommended (tiny static binary):
  aether watch --poll 5

Or install entr and rerun:
  find ... | entr -r ...

E
        return 1
    fi

    printf 'watch (entr) — modify files to trigger. Ctrl-C to stop.\n\n'

    cd "$root" || die "cd failed"
    # Feed entr a live list of paths from scope.
    # on-save MUST go through aether poke → run_hook (trust + --no-hooks),
    # never direct sh of the hook file (P0: entr trust bypass).
    (
        scope_dirs "$root" | while read -r d; do [ -d "$d" ] && printf '%s\n' "$d"; done | head -30 \
        | xargs -I{} find {} -type f \( -name '*.md' -o -name '*.py' -o -name '*.txt' -o -name '*.sh' \) 2>/dev/null \
        | grep -v '/.git/' | grep -v '/.aether/' | sort -u \
        | entr -d -r sh -c '
            echo "[aether] change"
            "'"$AETHER_SELF"'" distill "'"$root"'" --quiet || true
            "'"$AETHER_SELF"'" poke "'"$root"'" >/dev/null || true
        '
    )
}

cmd_repair() {
    p=$(get_path_arg "$@")
    root="$(project_root "$p")"
    ctx="$(ctx_file "$root")"
    printf 'repair: inspecting %s\n' "$root"
    if [ ! -d "$(aether_dir "$root")" ]; then
        printf '  .aether/ missing — run: aether init\n'
        return 1
    fi
    if [ ! -f "$ctx" ]; then
        printf '  .context.md missing — distilling\n'
    elif ! grep -q 'aether:generated:start' "$ctx" 2>/dev/null; then
        printf '  .context.md has no generated markers — distill will preserve body as human section\n'
    elif ! validate_context_markers "$ctx"; then
        printf '  .context.md CORRUPT markers (need exactly one start before one end)\n'
        printf '  refusing automatic distill — fix markers by hand, then: aether distill\n'
        return 1
    else
        printf '  .context.md OK (human + generated regions)\n'
    fi
    printf 'repair: distill (human section preserved)...\n'
    cmd_distill "$@"
}

# --- rhizome: capture / spark / session / graph -----------------------
# Doctrine: capture is sacred; structure is deferred. Seed never asks a
# question, never fails on missing dirs, never files anything.

cmd_seed() {
    # help flags must never land in the inbox
    case "${1:-}" in
        -h|--help|help) usage; return 0 ;;
    esac
    inbox="${AETHER_INBOX:-$HOME/inbox.md}"
    if [ $# -gt 0 ]; then
        text="$*"
    else
        text="$(cat | tr '\n' ' ')"
    fi
    # trim
    text="$(printf '%s' "$text" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -n "$text" ] || die_usage 'empty seed'
    if [ ! -f "$inbox" ]; then
        printf '# Inbox — seeds land here\n\nNever file at entry. distill sorts; you approve.\n\n' > "$inbox"
    fi
    printf -- '- %s %s\n' "$(now_iso)" "$text" >> "$inbox"
    printf 'seed planted → %s\n' "$inbox"
}

cmd_spark() {
    deck="${AETHER_SPARKS:-$HOME/prompts.md}"
    [ -f "$deck" ] || die "no spark deck at $deck (create it: one oblique line per line)"
    # Prefer bullet lines (- / *); else non-# non-empty lines. Never deal prose headers.
    bullets="$(grep -E '^[[:space:]]*[-*][[:space:]]+' "$deck" 2>/dev/null | sed 's/^[[:space:]]*[-*][[:space:]]*//')"
    if [ -n "$bullets" ]; then
        lines="$bullets"
    else
        lines="$(grep -v '^#' "$deck" | grep -v '^[[:space:]]*$')"
    fi
    [ -n "$lines" ] || die "spark deck is empty: $deck"
    if command -v shuf >/dev/null 2>&1; then
        printf '%s\n' "$lines" | shuf -n1
    else
        printf '%s\n' "$lines" | awk 'BEGIN{srand()} {a[NR]=$0} END{print a[int(rand()*NR)+1]}'
    fi
}

cmd_session() {
    root="$(pwd -P)"
    ledger="$root/.session.md"
    if [ $# -eq 0 ]; then
        [ -f "$ledger" ] && tail -20 "$ledger" || printf 'no session ledger here yet: aether session "listening: <track>"\n'
        return 0
    fi
    if [ ! -f "$ledger" ]; then
        printf '# Session ledger — %s\n\nInputs (what was playing) and outputs (what got made).\nThe middle stays unmanaged.\n\n' "$(basename "$root")" > "$ledger"
    fi
    printf -- '- %s %s\n' "$(now_iso)" "$*" >> "$ledger"
    printf 'logged → %s\n' "$ledger"
}

graph_id() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '_'; }

cmd_graph() {
    p=$(get_path_arg "$@")
    root="$(project_root "$p")"
    printf 'graph LR\n'
    collect_files "$root" | grep '\.md$' | while IFS= read -r f; do
        src="$(basename "$f" .md)"
        grep -o '\[\[[^]]*\]\]' "$f" 2>/dev/null | sed 's/^\[\[//;s/\]\]$//' | sort -u \
        | while IFS= read -r tgt; do
            [ -n "$tgt" ] || continue
            printf '  %s["%s"] --> %s["%s"]\n' \
                "$(graph_id "$src")" "$src" "$(graph_id "$tgt")" "$tgt"
        done
    done
}

