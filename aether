printf '\n  Verb list (AETHER_VERBS): %s\n' "$AETHER_VERBS"
}

main() {
    # Strip global flags while preserving original argument boundaries.
    # Never rebuild $@ via unquoted string join (destroys paths/quotes).
    set -- "$@" '::AETHER_END::'
    while [ "$1" != '::AETHER_END::' ]; do
        case "$1" in
            --no-hooks)
                AETHER_NO_HOOKS=1
                export AETHER_NO_HOOKS
                ;;
            *)
                set -- "$@" "$1"
                ;;
        esac
        shift
    done
    shift # drop ::AETHER_END::

    cmd=${1:-status}
    [ "$cmd" = "-h" ] || [ "$cmd" = "--help" ] || [ "$cmd" = "help" ] && { usage; exit 0; }
    [ "$cmd" = "--version" ] || [ "$cmd" = "-V" ] || [ "$cmd" = "version" ] && { cmd_version; exit 0; }
    [ "$cmd" = "verbs" ] && { cmd_verbs; exit 0; }
    [ "$#" -gt 0 ] && shift
    case "$cmd" in
        init)      cmd_init "$@" ;;
        onboard)   cmd_onboard "$@" ;;
        try)       cmd_try "$@" ;;
        panel)     cmd_panel "$@" ;;
        shell)     cmd_shell "$@" ;;
        desk|desk-serve)
            die "desk removed (unsacred). Use: aether shell  or  aether panel"
            ;;
        app)       cmd_app "$@" ;;
        deinit)    cmd_deinit "$@" ;;
        status)    cmd_status "$@" ;;
        distill)   cmd_distill "$@" ;;
        watch)     cmd_watch "$@" ;;
        repair)    cmd_repair "$@" ;;
        poke)      cmd_poke "$@" ;;
        trust)     cmd_trust "$@" ;;
        current)   cmd_current "$@" ;;
        preflight) cmd_preflight "$@" ;;
        approve)   cmd_approve "$@" ;;
        reject)    cmd_reject "$@" ;;
        next)      cmd_next "$@" ;;
        demo)      cmd_demo "$@" ;;
        brief)     cmd_brief "$@" ;;
        drift)     cmd_drift "$@" ;;
        probe)     cmd_probe "$@" ;;
        event)     cmd_event "$@" ;;
        artifact)  cmd_artifact "$@" ;;
        seed)      cmd_seed "$@" ;;
        spark)     cmd_spark "$@" ;;
        session)   cmd_session "$@" ;;
        graph)     cmd_graph "$@" ;;
        garden)    cmd_garden "$@" ;;
        rival)     cmd_rival "$@" ;;
        *)
            # Path shortcut only: `aether /some/dir` → status that project.
            # Unknown verbs must not print status and exit 0 (Opus peer 🔴-1 /
            # next-01-unknown-cmd): mistyped approve/preflight/next would look
            # like a successful gate check.
            if [ -d "$cmd" ]; then
                cmd_status "$cmd"
            else
                # If it is in AETHER_VERBS but not handled above, that is a bug.
                if aether_is_verb "$cmd"; then
                    die "internal: verb '$cmd' listed in AETHER_VERBS but not dispatched"
                fi
                printf 'aether: unknown command: %s\n' "$cmd" >&2
                printf 'aether: try: aether help  (or: aether verbs)\n' >&2
                exit 2
            fi
            ;;
    esac
}

main "$@"
