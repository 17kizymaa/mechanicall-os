            if [ -f "$appf" ]; then
                cat "$appf"
            else
                printf 'no app registered (run: aether app register <name>)\n'
                return 1
            fi
            ;;
        *)
            die_usage "usage: aether app register <name> [path]  |  aether app status [path]"
            ;;
    esac
}

cmd_deinit() {
    with_current=0
    yes=0
    path_arg="."
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --with-current) with_current=1; shift ;;
            --yes|-y) yes=1; shift ;;
            -*) die_usage "deinit: unknown flag: $1" ;;
            *) path_arg="$1"; shift; break ;;
        esac
    done
    root="$(project_root "$path_arg")"
    ad="$root/.aether"
    if [ ! -d "$ad" ]; then
        printf 'nothing to deinit (no .aether/ in %s)\n' "$root"
        return 0
    fi
    if [ "$yes" -ne 1 ]; then
        printf 'Remove %s ? [y/N] ' "$ad"
        IFS= read -r ans || true
        case "$ans" in
            y|Y|yes|YES) ;;
            *) printf 'aborted\n'; return 1 ;;
        esac
    fi
    rm -rf "$ad"
    printf 'removed: %s\n' "$ad"
    if [ "$with_current" -eq 1 ]; then
        cf="$(current_file "$root")"
        if [ -f "$cf" ]; then
            rm -f "$cf"
            printf 'removed: %s\n' "$cf"
        fi
    else
        printf 'kept CURRENT.md and human sidecars (pass --with-current to drop CURRENT.md)\n'
    fi
}


