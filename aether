#!/bin/sh
# aether — Awareness + Authority Layer for Mechanicall OS v0.2
#
# Single POSIX shell script.
# Filesystem is God. cat/grep/sed/awk are your debugger.
#
# Core commands (v0.1):
#   aether init | status | distill | watch | repair | trust | poke
#
# Authority commands (v0.2 — SPEC-v0.2.md):
#   aether current [init] [path]
#   aether preflight <action> [path]
#   aether approve [reason] [path]
#   aether reject [reason] [path]
#   aether event <msg> [path]
#   aether artifact <path> [--action A] [--status S] [--project DIR]
#
# Rhizome (docs/RHIZOME.md):
#   aether seed | spark | session | graph | garden | rival
#
# See SPEC-v0.1.md + SPEC-v0.2.md

set -e

# Single version string (Opus next-09) — usage, --version, and tests share this.
AETHER_VERSION="0.2"

# Single verb list (Opus next-09) — help summary + known-command checks + completion.
# Keep in sync with main() case arms (except removed desk|desk-serve aliases).
# shellcheck disable=SC2034 # consumed via $AETHER_VERBS word-split loops
AETHER_VERBS="init onboard try panel shell app deinit status distill watch repair poke trust current preflight approve reject next demo brief drift probe event artifact seed spark session graph garden rival help version verbs"

# Exit codes (SPEC-v0.2 / Opus NEXT-04):
#   0  success / allowed
#   1  internal error (also: aether drift when dirty — report, not crash)
#   2  usage error (unknown verb, bad args, invalid flags/ids)
#   3  protocol refusal (preflight/probe refuse; next refuse)
die() { printf 'aether: %s\n' "$*" >&2; exit 1; }
die_usage() { printf 'aether: %s\n' "$*" >&2; exit 2; }

aether_is_verb() {
    # aether_is_verb <name> — 0 if in AETHER_VERBS
    _v="$1"
    for _x in $AETHER_VERBS; do
        [ "$_x" = "$_v" ] && return 0
    done
    return 1
}

abspath() {
    case "$1" in
        ""|.) pwd -P ;;
        /*) printf '%s\n' "$1" ;;
        *)  printf '%s\n' "$(cd "$(dirname "$1")" 2>/dev/null && pwd -P)/$(basename "$1")" ;;
    esac
}

AETHER_SELF="$(abspath "$0")"
AETHER_ROOT="$(cd "$(dirname "$AETHER_SELF")" 2>/dev/null && pwd -P)"
# Prefer source tree (python/, docs/) over a bare copy in ~/.local/bin
if [ ! -d "$AETHER_ROOT/python" ] && [ ! -d "$AETHER_ROOT/docs" ]; then
    if [ -n "${AETHER_HOME:-}" ] && [ -d "$AETHER_HOME" ]; then
        AETHER_ROOT="$AETHER_HOME"
    elif [ -d "$HOME/mechanicall-os/python" ] || [ -f "$HOME/mechanicall-os/aether" ]; then
        AETHER_ROOT="$HOME/mechanicall-os"
    fi
fi

project_root() {
    if [ -n "$1" ]; then abspath "$1"; else pwd -P; fi
}

# Extract first non-flag argument as path (for subcommands)
get_path_arg() {
    for a in "$@"; do
        case "$a" in
            -*) continue ;;
            *) printf '%s\n' "$a"; return 0 ;;
        esac
    done
}

ensure_dir() { mkdir -p "$1" 2>/dev/null || true; }

# --- scope ------------------------------------------------------------

scope_file() { printf '%s/.aether/.scope\n' "$(project_root "$1")"; }

read_scope() {
    sf="$(scope_file "$1")"
    if [ -f "$sf" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ''|\#*) continue ;; *) printf '%s\n' "$line" ;; esac
        done < "$sf"
    else
        printf '.\n'
    fi
}

scope_dirs() {
    root="$(project_root "$1")"
    read_scope "$1" | while IFS= read -r p; do
        case "$p" in /*) printf '%s\n' "$p" ;; *) printf '%s/%s\n' "$root" "$p" ;; esac
    done
}

collect_files() {
    scope_dirs "$1" | while IFS= read -r d; do
        [ -d "$d" ] || continue
        find "$d" -type f \( -name '*.md' -o -name '*.py' -o -name '*.txt' -o -name '*.sh' \) 2>/dev/null \
            | grep -v '/.git/' | grep -v '/.aether/' | sort
    done | sort -u
}

file_count() { collect_files "$1" | wc -l | tr -d ' '; }
# One path per line; never xargs (splits on spaces in filenames).
tree_hash() {
    collect_files "$1" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        cksum "$f" 2>/dev/null || true
    done | cksum | awk '{print $1}'
}
# Prefer sub-second stamps so rapid seeds stay unique for the gardener.
now_iso() {
    if date -u +%Y-%m-%dT%H:%M:%S.%3NZ 2>/dev/null | grep -q '\.[0-9]'; then
        date -u +%Y-%m-%dT%H:%M:%S.%3NZ
    else
        date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date +%s
    fi
}

# --- paths ------------------------------------------------------------

ctx_file()   { printf '%s/.context.md\n'  "$(project_root "$1")"; }
aether_dir() { printf '%s/.aether\n'    "$(project_root "$1")"; }
state_file() { printf '%s/.aether/state.json\n' "$(project_root "$1")"; }
hooks_dir()  { printf '%s/.aether/hooks\n' "$(project_root "$1")"; }
current_file() { printf '%s/CURRENT.md\n' "$(project_root "$1")"; }
events_file()  { printf '%s/.aether/events.jsonl\n' "$(project_root "$1")"; }
artifacts_dir() { printf '%s/.aether/artifacts\n' "$(project_root "$1")"; }
preflight_last_file() { printf '%s/.aether/preflight-last\n' "$(project_root "$1")"; }
preflight_log_file()  { printf '%s/.aether/preflight.jsonl\n' "$(project_root "$1")"; }

ensure_aether_dirs() {
    ensure_dir "$(aether_dir "$1")"
    ensure_dir "$(hooks_dir "$1")"
    ensure_dir "$(artifacts_dir "$1")"
}

# Fingerprint for preflight receipt (git HEAD+dirty, else full tree of project files).
authority_fp() {
    root="$(project_root "$1")"
    if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        h="$(git -C "$root" rev-parse HEAD 2>/dev/null || printf 'unknown')"
        if [ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ]; then
            d=1
        else
            d=0
        fi
        printf 'git:%s:d%s' "$h" "$d"
    else
        # Broader than distill tree_hash: any non-.aether file change should STALE the receipt.
        fp=$(
            (cd "$root" && find . -type f ! -path './.aether/*' 2>/dev/null | sort | while IFS= read -r f; do
                cksum "$f" 2>/dev/null || true
            done | cksum | awk '{print $1}')
        )
        printf 'tree:%s' "${fp:-na}"
    fi
}

# Append-only + last-receipt (Opus next-06). Never blocks approve.
write_preflight_receipt() {
    # write_preflight_receipt <root> <action> <result> <ec>
    root="$(project_root "$1")"
    action="$2"
    result="$3"
    ec="$4"
    ensure_aether_dirs "$root"
    ts="$(now_iso)"
    fp="$(authority_fp "$root")"
    line=$(printf 'ts=%s|action=%s|result=%s|ec=%s|fp=%s' \
        "$ts" "$action" "$result" "$ec" "$fp")
    printf '%s\n' "$line" > "$(preflight_last_file "$root")"
    printf '%s\n' "$line" >> "$(preflight_log_file "$root")"
}

# Human-visible trace on approve: PASS / STALE / ABSENT (non-blocking).
print_preflight_receipt_status() {
    root="$(project_root "$1")"
    rf="$(preflight_last_file "$root")"
    if [ ! -f "$rf" ]; then
        printf 'preflight: ABSENT\n'
        return 0
    fi
    line=$(cat "$rf" 2>/dev/null || true)
    [ -n "$line" ] || { printf 'preflight: ABSENT\n'; return 0; }
    action=$(printf '%s' "$line" | sed -n 's/.*|action=\([^|]*\).*/\1/p')
    result=$(printf '%s' "$line" | sed -n 's/.*|result=\([^|]*\).*/\1/p')
    fp=$(printf '%s' "$line" | sed -n 's/.*|fp=\(.*\)$/\1/p')
    now="$(authority_fp "$root")"
    if [ -n "$fp" ] && [ "$fp" = "$now" ]; then
        printf 'preflight: PASS @ %s (current) action=%s result=%s\n' \
            "$fp" "${action:--}" "${result:--}"
    else
        printf 'preflight: STALE (checked %s, now %s) action=%s result=%s\n' \
            "${fp:--}" "$now" "${action:--}" "${result:--}"
    fi
}

# --- v0.2 authority: CURRENT.md + events + preflight ------------------
# Silence is never permission. Seeds/context never override CURRENT.

# Extract **Field:** value (first match) from CURRENT.md
# Accepts both Markdown styles:
#   **Field:** value     (colon inside bold — preferred)
#   **Field**: value     (colon outside bold)
current_field() {
    # usage: current_field <root> <FieldName>
    # FieldName is Objective|Phase|Status|Baseline|Next|Approval
    cf="$(current_file "$1")"
    [ -f "$cf" ] || return 1
    field="$2"
    line=$(grep -iE "^\*\*${field}:?\*\*[[:space:]]*:?" "$cf" 2>/dev/null | head -1) || return 1
    [ -n "$line" ] || return 1
    printf '%s\n' "$line" \
        | sed -E "s/^\*\*[^*]+:?\*\*[[:space:]]*:?[[:space:]]*//" \
        | sed 's/[[:space:]]*$//'
}

# List prohibited action tokens (one per line) from ## Prohibited section
current_prohibited() {
    cf="$(current_file "$1")"
    [ -f "$cf" ] || return 0
    awk '
        BEGIN { ignorecase = 1 }
        /^##[ \t]+Prohibited/ { in_sec=1; next }
        /^##[ \t]/ { if (in_sec) exit }
        in_sec && /^[ \t]*[-*][ \t]+/ {
            sub(/^[ \t]*[-*][ \t]+/, "")
            gsub(/[[:space:]]+$/, "")
            if (length($0)) print
        }
    ' "$cf"
}

# JSON-escape a string (minimal: backslash, quote, control -> space)
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n\r\t' '   '
}

# Append one JSONL event. Atomic-ish: write line via temp append.
append_event() {
    # append_event <root> <kind> <json_fields_without_braces>
    # Example: append_event "$root" preflight '"action":"x","result":"refused"'
    root="$(project_root "$1")"
    kind="$2"
    fields="$3"
    ensure_aether_dirs "$root"
    ef="$(events_file "$root")"
    ts="$(now_iso)"
    # Note: $(...) strips trailing newlines — always re-append \n on write.
    line=$(printf '{"ts":"%s","kind":"%s"%s}' \
        "$(json_escape "$ts")" \
        "$(json_escape "$kind")" \
        "${fields:+,}${fields}")
    if command -v flock >/dev/null 2>&1; then
        (
            flock 9
            printf '%s\n' "$line" >> "$ef"
        ) 9>>"$ef"
    else
        printf '%s\n' "$line" >> "$ef"
    fi
}

# Rewrite a **Field:** line in CURRENT.md (atomic). Creates field if missing
# after the title line.
current_set_field() {
    root="$(project_root "$1")"
    field="$2"
    value="$3"
    cf="$(current_file "$root")"
    [ -f "$cf" ] || die "no CURRENT.md at $cf — run: aether current init"
    tmp="$(aether_tmpfile "$root" current)"
    # Match **Field:** or **Field**:
    awk -v field="$field" -v value="$value" '
        BEGIN {
            IGNORECASE = 1
            re1 = "^\\*\\*" field ":\\*\\*"
            re2 = "^\\*\\*" field "\\*\\*[[:space:]]*:"
        }
        {
            if ($0 ~ re1 || $0 ~ re2) {
                print "**" field ":** " value
                done = 1
                next
            }
            print
        }
    ' "$cf" > "$tmp" || die "current_set_field: rewrite failed"
    if ! grep -qiE "^\*\*${field}:?\*\*" "$tmp" 2>/dev/null; then
        tmp2="$(aether_tmpfile "$root" current2)"
        awk -v field="$field" -v value="$value" '
            /^##/ && !ins { print "**" field ":** " value; print ""; ins=1 }
            { print }
            END { if (!ins) print "**" field ":** " value }
        ' "$tmp" > "$tmp2" || die "current_set_field: append failed"
        mv -f "$tmp2" "$tmp"
    fi
    mv -f "$tmp" "$cf"
}

write_current_template() {
    root="$(project_root "$1")"
    cf="$(current_file "$root")"
    [ -f "$cf" ] && die "CURRENT.md already exists: $cf"
    cat > "$cf" <<'TMPL'
# CURRENT

**Objective:** (one sentence — what must be true when we stop)
**Phase:** SELECT
**Status:** DRAFT
**Baseline:** (label or path)
**Next:** unset
**Approval:** PENDING

## Keep
- (what stays)

## Reject
- (what is dead)

## Limits
- (hard caps)

## Next allowed action
Human prose for the single authorized next step.

## Approval condition
Human runs: `aether approve "…"` (silence is never permission).

## Prohibited
- rough-v6
- full-reel-export
- automatic-rebuild
TMPL
    ensure_aether_dirs "$root"
    append_event "$root" current_init '"by":"human"'
    printf 'wrote %s\n' "$cf"
}

# SPEC-v0.2 schema check — protocol product surface (exit 0 ok, 1 fail)
cmd_current_validate() {
    path_arg=$(get_path_arg "$@")
    root="$(project_root "$path_arg")"
    cf="$(current_file "$root")"
    fail=0
    warn=0

    if [ ! -f "$cf" ]; then
        printf 'VALIDATE FAIL: CURRENT.md missing at %s\n' "$cf"
        printf '  create with: aether current init\n'
        return 1
    fi

    # Title
    if ! grep -qE '^#[[:space:]]*CURRENT' "$cf"; then
        printf 'FAIL: missing title line "# CURRENT"\n'
        fail=1
    fi

    for field in Objective Phase Status Next Approval; do
        val=$(current_field "$root" "$field" 2>/dev/null || true)
        if [ -z "$val" ]; then
            printf 'FAIL: missing or empty **%s:**\n' "$field"
            fail=1
        elif printf '%s' "$val" | grep -qE '^\(one sentence|^unset$|^\(label|^\(unset' ; then
            # placeholders ok for template but warn
            if [ "$field" = "Next" ] && [ "$val" = "unset" ]; then
                printf 'WARN: **Next:** is unset (set before EXECUTE)\n'
                warn=1
            elif [ "$field" != "Next" ]; then
                printf 'WARN: **%s:** looks like template placeholder: %s\n' "$field" "$val"
                warn=1
            fi
        fi
    done

    # Required sections
    for sec in Keep Reject Limits Prohibited; do
        if ! grep -qE "^##[[:space:]]+${sec}" "$cf"; then
            printf 'FAIL: missing section ## %s\n' "$sec"
            fail=1
        fi
    done
    if ! grep -qE '^##[[:space:]]+Next allowed action' "$cf"; then
        printf 'FAIL: missing section ## Next allowed action\n'
        fail=1
    fi
    if ! grep -qE '^##[[:space:]]+Approval condition' "$cf"; then
        printf 'FAIL: missing section ## Approval condition\n'
        fail=1
    fi

    # Lifecycle consistency: if Approval APPROVED and Status APPROVED, Next should not still be pending execute unless human re-set
    appr=$(current_field "$root" Approval 2>/dev/null || true)
    status=$(current_field "$root" Status 2>/dev/null || true)
    phase=$(current_field "$root" Phase 2>/dev/null || true)
    if printf '%s' "$appr" | grep -qi 'APPROVED' \
        && printf '%s' "$status" | grep -qi 'APPROVED' \
        && printf '%s' "$phase" | grep -qi 'APPROVE'; then
        printf 'WARN: Phase/Status/Approval all APPROVE(D) — prefer new Next after approve or set Phase EXECUTE/INTEGRATE\n'
        warn=1
    fi

    # Dual Next smell: two **Next:** lines
    ncount=$(grep -ciE '^\*\*Next:?\*\*' "$cf" 2>/dev/null || echo 0)
    if [ "${ncount:-0}" -gt 1 ] 2>/dev/null; then
        printf 'FAIL: multiple **Next:** field lines (one Next only)\n'
        fail=1
    fi

    if [ "$fail" -ne 0 ]; then
        printf '\nVALIDATE: FAIL (%s)\n' "$cf"
        return 1
    fi
    if [ "$warn" -ne 0 ]; then
        printf 'VALIDATE: OK (with warnings)\n'
    else
        printf 'VALIDATE: OK\n'
    fi
    printf '  root: %s\n' "$root"
    printf '  Next: %s\n' "$(current_field "$root" Next 2>/dev/null || echo unset)"
    return 0
}

cmd_current() {
    if [ "${1:-}" = "init" ]; then
        shift
        path_arg=$(get_path_arg "$@")
        root="$(project_root "$path_arg")"
        write_current_template "$root"
        return 0
    fi
    if [ "${1:-}" = "validate" ]; then
        shift
        cmd_current_validate "$@"
        return $?
    fi
    path_arg=$(get_path_arg "$@")
    root="$(project_root "$path_arg")"
    cf="$(current_file "$root")"

    if [ ! -f "$cf" ]; then
        printf 'CURRENT.md: MISSING (no authority file)\n'
        printf '  create with: aether current init [%s]\n' "$root"
        return 1
    fi

    printf 'root: %s\n' "$root"
    printf 'CURRENT.md: %s bytes\n\n' "$(wc -c < "$cf" | tr -d ' ')"
    obj=$(current_field "$root" Objective 2>/dev/null || true)
    phase=$(current_field "$root" Phase 2>/dev/null || true)
    status=$(current_field "$root" Status 2>/dev/null || true)
    base=$(current_field "$root" Baseline 2>/dev/null || true)
    next=$(current_field "$root" Next 2>/dev/null || true)
    appr=$(current_field "$root" Approval 2>/dev/null || true)
    printf 'Objective: %s\n' "${obj:-(unset)}"
    printf 'Phase:     %s\n' "${phase:-(unset)}"
    printf 'Status:    %s\n' "${status:-(unset)}"
    printf 'Baseline:  %s\n' "${base:-(unset)}"
    printf 'Next:      %s\n' "${next:-(unset)}"
    printf 'Approval:  %s\n' "${appr:-(unset)}"
    printf '\nProhibited:\n'
    prol=$(current_prohibited "$root")
    if [ -n "$prol" ]; then
        printf '%s\n' "$prol" | sed 's/^/  - /'
    else
        printf '  (none listed)\n'
    fi
    printf '\nInspect: cat %s\n' "$cf"
    printf 'Events:  cat %s\n' "$(events_file "$root")"
    printf 'Schema:  aether current validate\n'
}

# Case-insensitive exact match helper (returns 0 if equal)
str_eq_ci() {
    a=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    b=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
    [ "$a" = "$b" ]
}

# Returns 0 if action is prohibited.
# Match rules (case-insensitive):
#   1. exact match
#   2. action contains the full prohibited token (token length >= 3)
#   3. prohibited token contains the full action (action length >= 3)
# Short accidental substrings (e.g. action "x") never match.
action_is_prohibited() {
    root="$1"
    action="$2"
    al=$(printf '%s' "$action" | tr '[:upper:]' '[:lower:]')
    alen=${#al}
    hit=0
    while IFS= read -r p || [ -n "$p" ]; do
        [ -n "$p" ] || continue
        pl=$(printf '%s' "$p" | tr '[:upper:]' '[:lower:]')
        plen=${#pl}
        if [ "$al" = "$pl" ]; then hit=1; break; fi
        if [ "$plen" -ge 3 ]; then
            case "$al" in *"$pl"*) hit=1; break ;; esac
        fi
        if [ "$alen" -ge 3 ]; then
            case "$pl" in *"$al"*) hit=1; break ;; esac
        fi
    done <<EOF
$(current_prohibited "$root")
EOF
    [ "$hit" = 1 ]
}

# Record preflight allow/refuse unless AETHER_PREFLIGHT_DRY=1 (probe/brief).
preflight_record() {
    # preflight_record <root> <action> <result> <ec> <json_fields>
    root="$1"
    action="$2"
    result="$3"
    ec="$4"
    fields="$5"
    if [ "${AETHER_PREFLIGHT_DRY:-0}" = "1" ]; then
        return 0
    fi
    append_event "$root" preflight "$fields"
    write_preflight_receipt "$root" "$action" "$result" "$ec"
}

cmd_preflight() {
    action=""
    path_arg=""
    for a in "$@"; do
        case "$a" in
            -*) ;;
            *)
                if [ -z "$action" ]; then
                    action="$a"
                elif [ -z "$path_arg" ]; then
                    path_arg="$a"
                fi
                ;;
        esac
    done
    [ -n "$action" ] || die_usage 'usage: aether preflight <action> [path]'
    root="$(project_root "$path_arg")"
    cf="$(current_file "$root")"

    if [ ! -f "$cf" ]; then
        reason="no CURRENT.md — refuse all consequential actions (run: aether current init)"
        printf 'Refused: %s\n' "$reason"
        preflight_record "$root" "$action" refused 3 \
            "$(printf '"action":"%s","result":"refused","reason":"%s"' \
                "$(json_escape "$action")" "$(json_escape "$reason")")"
        return 3
    fi

    phase=$(current_field "$root" Phase || true)
    status=$(current_field "$root" Status || true)
    next=$(current_field "$root" Next || true)
    phase=${phase:-UNKNOWN}
    status=${status:-UNKNOWN}
    next=${next:-}

    # Prohibited list always wins
    if action_is_prohibited "$root" "$action"; then
        reason=$(printf '%s is prohibited while phase is %s. Next allowed action is %s.' \
            "$action" "$phase" "${next:-"(unset)"}")
        printf 'Refused: %s\n' "$reason"
        preflight_record "$root" "$action" refused 3 \
            "$(printf '"action":"%s","result":"refused","reason":"%s","phase":"%s","status":"%s"' \
                "$(json_escape "$action")" "$(json_escape "$reason")" \
                "$(json_escape "$phase")" "$(json_escape "$status")")"
        return 3
    fi

    # Blocked states: only exact Next may pass
    blocked=0
    case "$(printf '%s' "$status" | tr '[:lower:]' '[:upper:]')" in
        BLOCKED|BLOCKED-PENDING-HUMAN|REJECTED|DRAFT)
            blocked=1
            ;;
    esac

    if [ -n "$next" ]; then
        if str_eq_ci "$action" "$next"; then
            printf 'Allowed: %s matches Next (%s). Phase=%s Status=%s\n' \
                "$action" "$next" "$phase" "$status"
            preflight_record "$root" "$action" allowed 0 \
                "$(printf '"action":"%s","result":"allowed","phase":"%s","status":"%s"' \
                    "$(json_escape "$action")" "$(json_escape "$phase")" \
                    "$(json_escape "$status")")"
            return 0
        fi
        reason=$(printf '%s is not the next allowed action (%s). Phase=%s Status=%s.' \
            "$action" "$next" "$phase" "$status")
        printf 'Refused: %s\n' "$reason"
        preflight_record "$root" "$action" refused 3 \
            "$(printf '"action":"%s","result":"refused","reason":"%s","phase":"%s","status":"%s"' \
                "$(json_escape "$action")" "$(json_escape "$reason")" \
                "$(json_escape "$phase")" "$(json_escape "$status")")"
        return 3
    fi

    # No Next declared
    if [ "$blocked" = 1 ]; then
        reason=$(printf 'Status is %s and Next is unset — refuse %s (human must set Next in CURRENT.md).' \
            "$status" "$action")
        printf 'Refused: %s\n' "$reason"
        preflight_record "$root" "$action" refused 3 \
            "$(printf '"action":"%s","result":"refused","reason":"%s"' \
                "$(json_escape "$action")" "$(json_escape "$reason")")"
        return 3
    fi

    # Status open and no Next: allow with warning (human should set Next)
    printf 'Allowed: %s (no Next pin; Status=%s). Prefer setting **Next:** in CURRENT.md.\n' \
        "$action" "$status"
    preflight_record "$root" "$action" allowed 0 \
        "$(printf '"action":"%s","result":"allowed","warn":"no_next_pin","status":"%s"' \
            "$(json_escape "$action")" "$(json_escape "$status")")"
    return 0
}

cmd_approve() {
    # aether approve [reason...] [path]
    # Path: sole arg if it is a directory, or trailing directory arg peeled off reason.
    root="$(pwd -P)"
    reason=""
    if [ $# -eq 1 ] && [ -d "$1" ]; then
        root="$(project_root "$1")"
        reason=""
    elif [ $# -gt 1 ]; then
        # peel last arg if it is a directory
        last=$(eval "printf '%s' \"\${$#}\"")
        if [ -d "$last" ]; then
            root="$(project_root "$last")"
            # rebuild reason without last
            i=1
            n=$#
            while [ "$i" -lt "$n" ]; do
                eval "a=\${$i}"
                if [ -n "$reason" ]; then
                    reason="$reason $a"
                else
                    reason="$a"
                fi
                i=$((i + 1))
            done
        else
            reason="$*"
        fi
    else
        reason="$*"
    fi
    reason=${reason:-APPROVED}
    cf="$(current_file "$root")"
    [ -f "$cf" ] || die "no CURRENT.md — run: aether current init"

    # Trace only — never blocks (Grok seat / human is the gate). Opus next-06.
    print_preflight_receipt_status "$root"

    current_set_field "$root" Status APPROVED
    current_set_field "$root" Approval APPROVED
    # Advance phase toward post-review if still in EXECUTE/REVIEW
    phase=$(current_field "$root" Phase || true)
    case "$(printf '%s' "$phase" | tr '[:lower:]' '[:upper:]')" in
        EXECUTE|REVIEW|SELECT|COMMIT) current_set_field "$root" Phase APPROVE ;;
    esac

    append_event "$root" approve \
        "$(printf '"reason":"%s","by":"human"' "$(json_escape "$reason")")"
    # Durable human-readable trail
    if [ -f "$root/DECISIONS.md" ] || true; then
        if [ ! -f "$root/DECISIONS.md" ]; then
            printf '# DECISIONS\n\nAppend-only human decisions. Authority remains CURRENT.md.\n\n' \
                > "$root/DECISIONS.md"
        fi
        printf -- '- %s APPROVED: %s\n' "$(now_iso)" "$reason" >> "$root/DECISIONS.md"
    fi
    printf 'APPROVED: %s\n' "$reason"
    printf '  CURRENT Status/Approval updated. Events: %s\n' "$(events_file "$root")"
}

cmd_reject() {
    root="$(pwd -P)"
    reason="$*"
    if [ $# -eq 1 ] && [ -d "$1" ]; then
        root="$(project_root "$1")"
        reason=""
    fi
    reason=${reason:-REJECTED}
    cf="$(current_file "$root")"
    [ -f "$cf" ] || die "no CURRENT.md — run: aether current init"

    current_set_field "$root" Status REJECTED
    current_set_field "$root" Approval REJECTED
    current_set_field "$root" Phase SELECT
    # Do NOT auto-start another build — only return to SELECT

    append_event "$root" reject \
        "$(printf '"reason":"%s","by":"human","phase":"SELECT"' "$(json_escape "$reason")")"
    if [ ! -f "$root/DECISIONS.md" ]; then
        printf '# DECISIONS\n\nAppend-only human decisions. Authority remains CURRENT.md.\n\n' \
            > "$root/DECISIONS.md"
    fi
    printf -- '- %s REJECTED: %s (returned to SELECT; no automatic rebuild)\n' \
        "$(now_iso)" "$reason" >> "$root/DECISIONS.md"
    printf 'REJECTED: %s\n' "$reason"
    printf '  Phase → SELECT. No automatic rebuild. Events: %s\n' "$(events_file "$root")"
}

# Re-SELECT after APPROVED: set a new Next without hand-editing CURRENT.
# Usage: aether next <action-id> [path] [--reason TEXT]
# Exit 3 on protocol refuse (not approved / unchanged); exit 2 on usage.
cmd_next() {
    root="$(pwd -P)"
    action=""
    reason=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --reason)
                shift
                reason="${1:-}"
                [ -n "$reason" ] || die_usage 'usage: aether next <action-id> [path] [--reason TEXT]'
                shift
                ;;
            --reason=*)
                reason="${1#--reason=}"
                shift
                ;;
            -*)
                die_usage "unknown flag: $1"
                ;;
            *)
                if [ -z "$action" ]; then
                    action="$1"
                elif [ -d "$1" ]; then
                    root="$(project_root "$1")"
                else
                    die_usage "usage: aether next <action-id> [path] [--reason TEXT]"
                fi
                shift
                ;;
        esac
    done
    [ -n "$action" ] || die_usage 'usage: aether next <action-id> [path] [--reason TEXT]'
    # action-id: no spaces
    case "$action" in
        *[!A-Za-z0-9._-]*) die_usage "invalid action-id: $action (use letters, digits, ._- )" ;;
    esac

    cf="$(current_file "$root")"
    [ -f "$cf" ] || die "no CURRENT.md — run: aether current init"

    appr=$(current_field "$root" Approval 2>/dev/null || true)
    status=$(current_field "$root" Status 2>/dev/null || true)
    old=$(current_field "$root" Next 2>/dev/null || true)

    # Unchanged check first (clearer than "not approved" when already on this Next)
    if [ -n "$old" ] && str_eq_ci "$old" "$action"; then
        printf 'refuse: next unchanged (%s)\n' "$action" >&2
        return 3
    fi

    appr_u=$(printf '%s' "$appr" | tr '[:lower:]' '[:upper:]')
    status_u=$(printf '%s' "$status" | tr '[:lower:]' '[:upper:]')
    case "$appr_u" in
        *APPROVED*) ;;
        *)
            printf 'refuse: current action not approved; approve or reject first\n' >&2
            printf '  Approval=%s Status=%s Next=%s\n' "${appr:-(unset)}" "${status:-(unset)}" "${old:-(unset)}" >&2
            return 3
            ;;
    esac
    # Prefer Status also APPROVED, but Approval APPROVED is the gate
    if ! printf '%s' "$status_u" | grep -q 'APPROVED'; then
        printf 'refuse: current action not approved; approve or reject first\n' >&2
        printf '  Status=%s (want APPROVED) Approval=%s\n' "${status:-(unset)}" "${appr:-(unset)}" >&2
        return 3
    fi

    current_set_field "$root" Next "$action"
    current_set_field "$root" Phase SELECT
    current_set_field "$root" Status ACTIVE
    current_set_field "$root" Approval PENDING

    append_event "$root" next_selected \
        "$(printf '"from":"%s","to":"%s","by":"human","reason":"%s"' \
            "$(json_escape "$old")" "$(json_escape "$action")" "$(json_escape "${reason:-}")")"

    if [ ! -f "$root/DECISIONS.md" ]; then
        printf '# DECISIONS\n\nAppend-only human decisions. Authority remains CURRENT.md.\n\n' \
            > "$root/DECISIONS.md"
    fi
    printf -- '- %s NEXT_SELECTED: %s -> %s%s\n' \
        "$(now_iso)" "${old:-(unset)}" "$action" \
        "${reason:+ ($reason)}" >> "$root/DECISIONS.md"

    printf 'NEXT_SELECTED: %s -> %s\n' "${old:-(unset)}" "$action"
    printf '  Phase=SELECT Status=ACTIVE Approval=PENDING\n'
    printf '  Events: %s\n' "$(events_file "$root")"
    return 0
}

