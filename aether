cmd_app() {
    sub="${1:-}"
    [ -n "$sub" ] || die_usage "usage: aether app register <name> [path]"
    shift
    case "$sub" in
        register)
            name="${1:-}"
            [ -n "$name" ] || die_usage "usage: aether app register <name> [path]"
            shift
            path_arg=$(get_path_arg "$@")
            root="$(project_root "$path_arg")"
            if [ ! -d "$root/.aether" ]; then
                cmd_init "$root"
            fi
            # kind defaults to development application (UI-forking flow)
            purpose="Critique and adapt this codebase for my usage."
            write_dev_app_current "$root" "$purpose"
            cheat=$(write_commands_cheatsheet "$root")
            ts="$(now_iso)"
            appf="$root/.aether/app.json"
            # plain JSON — no jq required
            cat > "$appf" <<JSON
{
  "name": "$(json_escape "$name")",
  "kind": "development",
  "purpose": "$(json_escape "$purpose")",
  "registered_at": "$(json_escape "$ts")",
  "cheatsheet": ".aether/COMMANDS.md"
}
JSON
            append_event "$root" app_register \
                "$(printf '"name":"%s","kind":"development"' "$(json_escape "$name")")"
            if [ -f "$AETHER_ROOT/python/aether_panel.py" ]; then
                python3 "$AETHER_ROOT/python/aether_panel.py" "$root" --write >/dev/null 2>&1 || true
            fi
            printf 'registered development application: %s\n' "$name"
