# Desk-only. Copy values to ~/Desktop/.env (already loaded) or a gitignored .env here.
# Never commit real keys. Never bake into the APK.
#
# aether_fs also accepts a bare sk-or-… line as OPENROUTER_API_KEY (first one wins).
# Prefer KEY=value so a weekly budget can live next to the key.

OPENROUTER_API_KEY=
OPENROUTER_WEEKLY_BUDGET_USD=10
